# Copy to .env and fill in. docker compose reads .env automatically.
#   cp .env.example .env
# Generate the three secrets with:
#   openssl rand -base64 24

# ---- Postgres -------------------------------------------------------------
POSTGRES_DB=duryssoile
POSTGRES_USER=duryssoile
POSTGRES_PASSWORD=

# ---- RustFS (S3-compatible object storage for the audio) ------------------
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=audio
# Host port for the RustFS web console (the S3 API is never published).
RUSTFS_CONSOLE_PORT=9001

# ---- Admin page -----------------------------------------------------------
# The single password for /admin/. There is no user table.
ADMIN_PASSWORD=
# Signs the admin session cookie. Changing it logs everyone out.
SECRET_KEY=

# ---- HTTP -----------------------------------------------------------------
HTTP_PORT=8080

# ---- Seeding (the `init` service, which runs on every `up`) ---------------
# sync -- converge; do nothing when already in sync (default)
# hard -- drop the tables, empty the audio bucket, rebuild everything
INIT_MODE=sync

# ---- Audio ----------------------------------------------------------------
# Host directory holding the pronunciation clips, laid out as
#   <AUDIO_DIR>/parasite/<filename>.mp3
#   <AUDIO_DIR>/commonly-mispronounced/<filename>.mp3
# where <filename> is the `filename` field in data/*.json. Mounted read-only
# into the init container, which uploads the clips into RustFS.
AUDIO_DIR=./audio

# Parallel uploads into RustFS.
UPLOAD_CONCURRENCY=16
