# Copy to .env and fill in. docker compose reads .env automatically.
#   cp .env.example .env
#
# Generate each secret as letters and digits only:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
#
# Do NOT use `openssl rand -base64`: it can emit '/' and '+'. A '/' in
# RUSTFS_ACCESS_KEY corrupts the slash-delimited Credential= field of the
# SigV4 Authorization header, and RustFS rejects every request with
# "Invalid SigV4 authorization header".

# ---- Postgres -------------------------------------------------------------
POSTGRES_DB=duryssoile
POSTGRES_USER=duryssoile
POSTGRES_PASSWORD=

# ---- RustFS (S3-compatible object storage for the audio) ------------------
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=audio
# Host port for the RustFS web console (the S3 API is never published).
RUSTFS_CONSOLE_PORT=9001

# ---- Admin page -----------------------------------------------------------
# The single password for /admin/. There is no user table.
ADMIN_PASSWORD=
# Signs the admin session cookie. Changing it logs everyone out.
SECRET_KEY=

# ---- HTTP / HTTPS (the caddy service) -------------------------------------
# off -- plain HTTP only (local development)
# on  -- HTTPS for DOMAIN with a Let's Encrypt certificate that Caddy obtains
#        and renews itself; plain HTTP redirects to HTTPS (301). DOMAIN must
#        resolve to this host and port 443 must be reachable from the
#        internet (Let's Encrypt validates over it). Also marks the admin
#        session cookie Secure.
TLS=off
#DOMAIN=duryssoile.nu.edu.kz

# Host ports. In production with TLS=on these must be 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# ---- Seed import (the `setup` service, into an empty database only) -------
# The clips are read from ./seed/audio, laid out as
#   seed/audio/parasite/<filename>.mp3
#   seed/audio/commonly-mispronounced/<filename>.mp3
# where <filename> is the `filename` field in seed/data/*.json. Set
# AUDIO_DIR to read them from another host directory instead.
#AUDIO_DIR=/srv/duryssoile/audio

# Parallel uploads into RustFS.
UPLOAD_CONCURRENCY=16
